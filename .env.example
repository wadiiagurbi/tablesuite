# Copy this file to .env.local (never commit .env.local) and fill in your Supabase
# project's values — Project Settings > API in the Supabase dashboard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by supabase/seed.mjs (server-side, never shipped to the browser).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SEED_OWNER_EMAIL=owner@thegoldenfork.com
SEED_OWNER_PASSWORD=change-me-before-real-use
